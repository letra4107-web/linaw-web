PORT=4000

# Read-only staging smoke tests. Tests stay skipped unless explicitly enabled.
# E2E_ALLOW_STAGING_TESTS=true
# E2E_API_URL=https://api-staging.example.com
# E2E_FRONTEND_URL=https://staging.example.com
# E2E_SUPABASE_URL=https://your-staging-project.supabase.co
# E2E_SUPABASE_ANON_KEY=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_TEACHER_EMAIL=
# E2E_TEACHER_PASSWORD=
# E2E_PARENT_EMAIL=
# E2E_PARENT_PASSWORD=
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
# Optional known-cross-account IDs for staging RLS isolation tests.
# E2E_OTHER_CHILD_ID=
# E2E_OTHER_STUDENT_ID=
# E2E_UNASSIGNED_STUDENT_ID=
# Comma-separated exact origins. Production example:
# CORS_ORIGIN=https://linawletra.com,https://www.linawletra.com
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_VERSION=0.1.0
API_COMPATIBILITY_VERSION=3
# Optional deployment-provided commit marker (for example Railway's git SHA).
GIT_COMMIT_SHA=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_TTS_API_KEY=

# Keep false until web/mobile consumers use the ownership-checked access URL APIs.
STORAGE_SIGNED_URLS_ENABLED=false

# SMTP for login 2FA / credential emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LinawLetra <no-reply@linawletra.app>"
