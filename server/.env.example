# Copy to server/.env and supply private values locally or in the hosting platform.
# Never put real credentials in this tracked example.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="LinawLetra <noreply@example.com>"
BREVO_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
STORAGE_SIGNED_URLS_ENABLED=false
API_COMPATIBILITY_VERSION=3
APP_VERSION=0.1.0
GIT_COMMIT_SHA=
