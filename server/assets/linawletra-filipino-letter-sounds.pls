<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
  xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
  alphabet="ipa" xml:lang="fil-PH">
  <lexeme><grapheme>A</grapheme><phoneme>a</phoneme></lexeme>
  <lexeme><grapheme>E</grapheme><phoneme>ɛ</phoneme></lexeme>
  <lexeme><grapheme>I</grapheme><phoneme>i</phoneme></lexeme>
  <lexeme><grapheme>O</grapheme><phoneme>o</phoneme></lexeme>
  <lexeme><grapheme>U</grapheme><phoneme>u</phoneme></lexeme>
  <lexeme><grapheme>M</grapheme><phoneme>ma</phoneme></lexeme>
  <lexeme><grapheme>S</grapheme><phoneme>sa</phoneme></lexeme>
</lexicon>
