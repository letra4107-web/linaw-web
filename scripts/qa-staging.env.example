# Copy to .qa/staging.env. Never use the shared development project.
E2E_ALLOW_STAGING_TESTS=true
E2E_ALLOW_FIXTURE_WRITES=false
E2E_API_URL=http://127.0.0.1:4400
E2E_FRONTEND_URL=http://127.0.0.1:5180
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_ALLOWED_SUPABASE_HOST=127.0.0.1
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Provisioning writes random credentials here, never to stdout or reports.
# .qa/test-accounts.json is ignored by Git.
E2E_ACCOUNT_FILE=.qa/test-accounts.json
# Complete baseline schema must already be installed in the isolated project.
E2E_SCHEMA_BASELINE_CONFIRMED=false
# Optional real delivery/recognition verification requires test SMTP/provider
# configuration and an actual microphone. Do not reuse real student data.
