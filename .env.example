# Supabase project (shared with the LinawLetra mobile app)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of this project's own Express API (server/)
VITE_API_URL=http://localhost:4000/api
VITE_APP_VERSION=0.1.0
VITE_API_COMPATIBILITY_VERSION=3

# Optional privacy-reviewed event collector. Leave blank to keep events local-only.
VITE_ANALYTICS_ENDPOINT=
