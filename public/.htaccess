# SPA routing: let React Router handle all non-file paths client-side.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html must always be re-fetched -- it references the current build's
# content-hashed asset filenames, so a stale cached copy of it points at
# assets that no longer exist on the server. The hashed assets themselves
# (js/css/images) are safe to cache aggressively since a content change
# always produces a new filename.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://linawletra-production-409e.up.railway.app; media-src 'self' data: blob:; frame-src 'self' blob: https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <!-- favicon.svg/icons.svg are unhashed filenames in public/ (unlike the
       content-hashed dist/assets/* files above) -- an update to either would
       get stuck behind the year-long immutable cache forever otherwise. -->
  <FilesMatch "^(favicon|icons)\.svg$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Hostinger's LiteSpeed page cache otherwise serves a stale cached index.html
# across deploys, independent of the Cache-Control header above.
<IfModule LiteSpeed>
  CacheDisable public /index.html
</IfModule>
